{
  "name": "pi-holdpty",
  "version": "0.5.0",
  "description": "Pi-flavored holdpty fork: detached PTY + watchexec-style regex watcher + exit notifications + session ownership. Fork of marcfargas/holdpty.",
  "type": "module",
  "license": "MIT",
  "author": "buihongduc132",
  "homepage": "https://github.com/buihongduc132/pi-holdpty#readme",
  "bugs": {
    "url": "https://github.com/buihongduc132/pi-holdpty/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buihongduc132/pi-holdpty.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "holdpty-fork",
    "watcher",
    "pty",
    "terminal",
    "detach",
    "attach",
    "screen",
    "tmux",
    "dtach",
    "node-pty",
    "cross-platform",
    "windows",
    "conpty"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "bin": {
    "holdpty": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.js.map",
    "dist/cli.d.ts",
    "dist/client.js",
    "dist/client.js.map",
    "dist/client.d.ts",
    "dist/holder.js",
    "dist/holder.js.map",
    "dist/holder.d.ts",
    "dist/platform.js",
    "dist/platform.js.map",
    "dist/platform.d.ts",
    "dist/protocol.js",
    "dist/protocol.js.map",
    "dist/protocol.d.ts",
    "dist/ring-buffer.js",
    "dist/ring-buffer.js.map",
    "dist/ring-buffer.d.ts",
    "dist/line-filter.js",
    "dist/line-filter.js.map",
    "dist/line-filter.d.ts",
    "dist/session.js",
    "dist/session.js.map",
    "dist/session.d.ts",
    "dist/event-stream.js",
    "dist/event-stream.js.map",
    "dist/event-stream.d.ts",
    "dist/watcher-filter.js",
    "dist/watcher-filter.js.map",
    "dist/watcher-filter.d.ts",
    "dist/cli-commands.js",
    "dist/cli-commands.js.map",
    "dist/cli-commands.d.ts",
    "dist/ownership.js",
    "dist/ownership.js.map",
    "dist/ownership.d.ts",
    "dist/staleness.js",
    "dist/staleness.js.map",
    "dist/staleness.d.ts",
    "scripts/fix-node-pty-permissions.js",
    "extensions/",
    "skills/",
    ".well-known/",
    "LICENSE",
    "LICENSE-CC0",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/platform.test.ts src/ring-buffer.test.ts src/protocol.test.ts",
    "test:integration": "vitest run src/integration.test.ts",
    "test:e2e": "vitest run src/e2e.test.ts",
    "lint": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "smoke-test": "npm run build && node --experimental-strip-types --no-warnings scripts/smoke-test.ts",
    "postinstall": "node scripts/fix-node-pty-permissions.js",
    "prepublishOnly": "npm run lint && npm run test"
  },
  "dependencies": {
    "@types/node": "^22.0.0",
    "node-pty": "^1.0.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^3.0.0",
    "@vitest/coverage-v8": "^3.2.1",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
